Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html

RewriteEngine On

# ── Un solo host canónico: https://www en 1 salto ─────────────────
# (antes https://sanaliayasociados.com respondía 200 sin redirigir = sitio duplicado)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.sanaliayasociados.com%{REQUEST_URI} [L,R=301]

# ── Archivos ocultos y de configuración: nunca públicos (excepto /.well-known) ──
RewriteRule (^|/)\.(?!well-known) - [F,L]
<FilesMatch "\.(env|ini|log|sql|bak|sh|md|yml|yaml|lock)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(index|404)\.md$">
  Require all granted
</FilesMatch>
<FilesMatch "^(htaccess\.txt|composer\.json|config\.php\.example)$">
  Require all denied
</FilesMatch>

# ── GEO: servir index.md cuando un agente pide text/markdown ──────
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ /index.md [L]

# ── Eliminar /index.html de URLs de directorio (301) ─────────────
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# ── Eliminar .html de cualquier otra página (301) ─────────────────
RewriteCond %{THE_REQUEST} \.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# ── Servir el archivo .html internamente sin extensión ────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ── Página de error 404 (status real, no soft-404) ─────────────────
ErrorDocument 404 /404.html

# ── Tipos y charset explícitos (sin charset, los acentos de llms.txt se rompen) ──
AddType text/markdown .md
AddType application/xml .xml
AddCharset utf-8 .txt .xml .json .md .html .css .js

# ── Headers de seguridad ────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always unset X-XSS-Protection
  Header unset X-Powered-By

  # ── Performance: cache ──────────────────────────────────────────
  # CSS/JS immutable 1 año: el HTML los referencia con ?v=AAAAMMDD; subir la versión al cambiarlos
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|webp|avif|svg|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, must-revalidate, s-maxage=60"
  </FilesMatch>

  # ── GEO / content negotiation ────────────────────────────────────
  <FilesMatch "\.txt$">
    Header always set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.md$">
    Header always set Content-Type "text/markdown; charset=utf-8"
  </FilesMatch>
  Header append Vary "Accept"
</IfModule>
