<?php
/**
 * Sanalia & Asociados — Configuración SMTP
 *
 * 1. Copia este archivo a config.php  (mismo directorio)
 * 2. Completa los valores reales
 * 3. Asegúrate de que config.php esté en .gitignore — NUNCA subir al repo
 *
 * Hosting objetivo: Banahosting (cPanel) — usar las credenciales del correo
 * info@sanaliayasociados.com creado en cPanel → Email Accounts.
 */

// ── Base de datos (CRM) ───────────────────────────────────────
define('DB_HOST', 'localhost');
define('DB_NAME', 'nombre_de_tu_base_de_datos');
define('DB_USER', 'usuario_mysql');
define('DB_PASS', 'password_mysql');

// ── IA / Groq ─────────────────────────────────────────────────
// Gratis en console.groq.com → API Keys → Create API Key
define('GROQ_API_KEY', 'gsk_TU_KEY_AQUI');

return [

    // ── SMTP ──────────────────────────────────────────────────
    'smtp_host'     => 'mail.sanaliayasociados.com', // servidor de salida (cPanel típico)
    'smtp_port'     => 465,                           // 465 = SSL  |  587 = TLS/STARTTLS
    'smtp_secure'   => 'ssl',                         // 'ssl' o 'tls'
    'smtp_user'     => 'info@sanaliayasociados.com',
    'smtp_pass'     => 'TU_PASSWORD_AQUI',

    // ── Destino ───────────────────────────────────────────────
    'mail_to'       => 'info@sanaliayasociados.com',  // quién recibe los mensajes del formulario
    'mail_from'     => 'info@sanaliayasociados.com',  // From (debe coincidir con smtp_user en cPanel)
    'mail_from_name'=> 'Sitio Web — Sanalia & Asociados',

    // ── Rate limiting ─────────────────────────────────────────
    'rate_limit_max'  => 5,    // máximo de envíos por IP
    'rate_limit_ttl'  => 3600, // ventana en segundos (1 hora)
    'rate_limit_dir'  => __DIR__ . '/../storage/rate/',

    // ── Log ───────────────────────────────────────────────────
    'log_file'        => __DIR__ . '/../storage/logs/contact.log',

];
